+        let mut fresh = RopeLRU::new(2);
+        let (cos, sin) = fresh.get(make_key(1.0 + 5e-10, 32));
+        assert_eq!(actual, (cos.to_vec(), sin.to_vec()));
+        assert_ne!(first, actual.0);
+    }
