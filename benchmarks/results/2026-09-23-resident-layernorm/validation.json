        "-c",
        "import json,torch\ntorch.set_num_threads(4)\ntorch.set_num_interop_threads(1)\nassert torch.backends.mps.is_available()\nresults=[]\nfixtures=[([[0.,1.,2.],[2.,0.,-1.]],[.5,1.5,-.75],[.2,-.3,.4],.05,False),([[.4,-.8,1.2],[-.3,.9,-1.1],[.7,.1,-.2]],[1.7,.5,-.8],[.2,-.3,.6],.1,True)]\nfor device in (\"cpu\",\"mps\"):\n for values,tg,tb,rate,expected in fixtures:\n  x=torch.tensor(values,device=device)\n  target=torch.nn.functional.layer_norm(x,(3,),torch.tensor(tg,device=device),torch.tensor(tb,device=device),1e-5)\n  g=torch.ones(3,device=device,requires_grad=True)\n  b=torch.zeros(3,device=device,requires_grad=True)\n  optimizer=torch.optim.SGD([g,b],lr=rate)\n  for step in range(400):\n   optimizer.zero_grad()\n   loss=torch.nn.functional.mse_loss(torch.nn.functional.layer_norm(x,(3,),g,b,1e-5),target)\n   if step==0: first=loss.detach().clone()\n   loss.backward()\n   optimizer.step()\n  first,last=first.item(),loss.item()\n  assert (last < first*1e-4)==expected\n  results.append(dict(device=device,steps=400,last_loss_step=399,learning_rate=rate,first=first,last=last,meets_1e_4=expected,gamma=g.detach().cpu().tolist(),beta=b.detach().cpu().tolist()))\nprint(json.dumps(dict(schema=\"spiraltorch.layer_norm.training_control.v1\",status=\"passed\",torch_version=torch.__version__,cases=results)))\n"
      ],
