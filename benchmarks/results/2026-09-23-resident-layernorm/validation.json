    "training-mps-isolate": {
      "command": [
        "env",
        "PYTORCH_ENABLE_MPS_FALLBACK=0",
        "/Library/Frameworks/Python.framework/Versions/3.12/bin/python3.12",
        "-I",
        "-B",
        "-c",
        "import torch,json,os\ntorch.set_num_threads(4)\ntorch.set_num_interop_threads(1)\nresult=[]\nfor device in (\"cpu\",\"mps\"):\n x=torch.tensor([[.4,-.8,1.2],[-.3,.9,-1.1],[.7,.1,-.2]],device=device)\n tg=torch.tensor([1.7,.5,-.8],device=device)\n tb=torch.tensor([.2,-.3,.6],device=device)\n target=torch.nn.functional.layer_norm(x,(3,),tg,tb,1e-5)\n g=torch.ones(3,device=device,requires_grad=True)\n b=torch.zeros(3,device=device,requires_grad=True)\n for step in range(3):\n  y=torch.nn.functional.layer_norm(x,(3,),g,b,1e-5)\n  loss=torch.nn.functional.mse_loss(y,target)\n  dy,dg,db=torch.autograd.grad(loss,(y,g,b),retain_graph=True)\n  expected=2*(y-target)/y.numel()\n  sg,sb=torch.autograd.grad(y,(g,b),expected)\n  result.append(dict(device=device,step=step,loss=loss.item(),dy=dy.cpu().tolist(),expected=expected.cpu().tolist(),dg=dg.cpu().tolist(),dg_seed=sg.cpu().tolist(),db=db.cpu().tolist(),db_seed=sb.cpu().tolist()))\n  with torch.no_grad():\n   g.add_(dg,alpha=-.1)\n   b.add_(db,alpha=-.1)\nprint(json.dumps(dict(cases=result,environment={k:os.environ.get(k) for k in [\"PYTORCH_ENABLE_MPS_FALLBACK\",\"PYTORCH_MPS_FAST_MATH\",\"PYTORCH_MPS_PREFER_METAL\"]}),allow_nan=False))\n"
      ],
